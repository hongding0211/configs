font-family = "CaskaydiaCove Nerd Font Mono"
font-size = 14.0
cursor-style = block
cursor-style-blink = false
window-width = 130
window-height = 40
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# Give text a little breathing room
window-padding-x = 6
window-padding-y = 4
window-padding-balance = true

# More useful history than the default 10MB
scrollback-limit = 50000000

# Do not auto-copy selection; use Cmd+C to copy
copy-on-select = false

# Option as Alt, useful for shell/tmux/nvim/readline shortcuts
macos-option-as-alt = true
